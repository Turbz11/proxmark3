#include "standalone.h"
#include "proxmark3.h"
#include "rf.h"
#include "flash.h"
#include "apdu.h"
#include "led.h"

void RunMod(void) {
    // 1. Initialize HF mode for EMV card reading (13.56 MHz)
    rf_init();
    rf_set_mode(RF_MODE_HF);

    // 2. Detect an EMV card
    uint8_t card_detected = detect_emv_card();
    if (!card_detected) {
        led_on(LED_ERROR);  // Indicate error (no card detected)
        return;
    }
    
    led_on(LED_OK);  // Indicate card detected (green LED)

    // 3. Send APDU command to retrieve card data (e.g., PAN, Expiry Date)
    uint8_t apdu_command[] = {0x00, 0xB0, 0x00, 0x00, 0x10};  // Example command
    uint8_t response[256];
    int response_length = send_apdu_command(apdu_command, sizeof(apdu_command), response);

    if (response_length <= 0) {
        led_on(LED_ERROR);  // Indicate error (failed to read data)
        return;
    }

    // 4. Parse the EMV response to extract card information
    char pan[20];
    char expiry[5];
    parse_emv_response(response, pan, expiry);

    // 5. Store the parsed data in flash memory
    flash_write_data(pan, sizeof(pan));
    flash_write_data(expiry, sizeof(expiry));

    // 6. Indicate success via LEDs or beeps
    led_on(LED_OK);  // Green LED for success
    beep(1);         // Beep once to indicate success
}

